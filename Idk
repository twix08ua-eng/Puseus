-- ==========================================================
--  Drag: кнопка
-- ==========================================================
local btnStart, btnPos, btnDragging = nil, nil, false

button.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        btnDragging = false
        btnStart    = input.Position
        btnPos      = btnHolder.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if not btnStart then return end
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        local delta = input.Position - btnStart
        if delta.Magnitude > 4 then
            btnDragging = true
            btnHolder.Position = UDim2.new(
                btnPos.X.Scale, btnPos.X.Offset + delta.X,
                btnPos.Y.Scale, btnPos.Y.Offset + delta.Y
            )
        end
    end
end)

UIS.InputEnded:Connect(function(input)
    if (input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch) and btnStart then
        if not btnDragging then
            pressAnim()
            panel.Visible = not panel.Visible
        end
        btnStart = nil
        btnDragging = false
    end
end)

-- ==========================================================
--  Drag: панель
-- ==========================================================
local pDrag, pStart, pPos = false, nil, nil

header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pDrag  = true
        pStart = input.Position
        pPos   = panel.Position
    end
end)

UIS.InputChanged:Connect(function(input)
    if pDrag and (input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - pStart
        panel.Position = UDim2.new(
            pPos.X.Scale, pPos.X.Offset + delta.X,
            pPos.Y.Scale, pPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        pDrag = false
    end
end)

closeBtn.MouseButton1Click:Connect(function()
    panel.Visible = false
end)

