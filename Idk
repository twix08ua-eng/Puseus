local setTab, refreshScripts

local function sanitizeName(name)
    return (name:gsub("[^%w_%-%.]", "_"))
end

local function saveScript()
    local name = nameBox.Text
    if name == "" then
        setStatus("⚠ Введите имя скрипта", Color3.fromRGB(255, 200, 100))
        return
    end
    if codeBox.Text == "" then
        setStatus("⚠ Скрипт пустой", Color3.fromRGB(255, 200, 100))
        return
    end
    local safe = sanitizeName(name)
    local path = SCRIPTS_FOLDER .. "/" .. safe .. ".lua"
    writefile(path, codeBox.Text)
    writefile(SCRIPTS_FOLDER .. "/" .. safe .. ".name", name)
    nameBox.Text = ""
    setStatus("✅ Скрипт сохранён: " .. name, Color3.fromRGB(120, 255, 120))
    refreshScripts()
end

function refreshScripts()
    for _, child in ipairs(listScroll:GetChildren()) do
        if child:IsA("Frame") then child:Destroy() end
    end
    local files = listfiles(SCRIPTS_FOLDER)
    for _, filepath in ipairs(files) do
        local fname = filepath:match("([^/\\]+)$")
        if fname and fname:sub(-4) == ".lua" then
            local baseName    = fname:sub(1, -5)
            local displayName = baseName
            local namePath    = SCRIPTS_FOLDER .. "/" .. baseName .. ".name"
            if isfile(namePath) then
                local ok2, n = pcall(readfile, namePath)
                if ok2 and n and n ~= "" then displayName = n end
            end

            local item = Instance.new("Frame")
            item.Size             = UDim2.new(1, -8, 0, 36)
            item.BackgroundColor3 = Color3.fromRGB(28, 28, 40)
            item.BorderSizePixel  = 0
            item.ZIndex           = 13
            item.Parent           = listScroll
            corner(item, 5)

            local nameLbl = Instance.new("TextLabel")
            nameLbl.Size             = UDim2.new(1, -140, 1, 0)
