local function createSlider(parent, name, minV, maxV, defaultV, yPos, callback)
    local fr = Instance.new("Frame")
    fr.Size              = UDim2.new(1, 0, 0, 55)
    fr.Position          = UDim2.new(0, 0, 0, yPos)
    fr.BackgroundTransparency = 1
    fr.ZIndex            = 12
    fr.Parent            = parent

    local lbl = Instance.new("TextLabel")
    lbl.Size             = UDim2.new(1, 0, 0, 22)
    lbl.BackgroundTransparency = 1
    lbl.Text             = name .. ": " .. tostring(defaultV)
    lbl.TextColor3       = Color3.fromRGB(220, 220, 240)
    lbl.TextXAlignment   = Enum.TextXAlignment.Left
    lbl.Font             = Enum.Font.Gotham
    lbl.TextSize         = 14
    lbl.ZIndex           = 13
    lbl.Parent           = fr

    local bar = Instance.new("Frame")
    bar.Size             = UDim2.new(1, 0, 0, 18)
    bar.Position         = UDim2.new(0, 0, 0, 28)
    bar.BackgroundColor3 = Color3.fromRGB(40, 40, 55)
    bar.BorderSizePixel  = 0
    bar.ZIndex           = 13
    bar.Parent           = fr
    corner(bar, 9)

    local fill = Instance.new("Frame")
    fill.Size             = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
    fill.BorderSizePixel  = 0
    fill.ZIndex           = 14
    fill.Parent           = bar
    corner(fill, 9)

    local handle = Instance.new("Frame")
    handle.Size             = UDim2.new(0, 14, 1, 0)
    handle.Position         = UDim2.new(1, 0, 0, 0)
    handle.AnchorPoint      = Vector2.new(0.5, 0)
    handle.BackgroundColor3 = Color3.fromRGB(220, 230, 255)
    handle.BorderSizePixel  = 0
    handle.ZIndex           = 15
    handle.Parent           = fill
    corner(handle, 7)

    local dragging = false
    local function updateFromX(x)
        local rel = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
        local val = minV + (maxV - minV) * rel
        fill.Size = UDim2.new(rel, 0, 1, 0)
        lbl.Text  = name .. ": " .. string.format("%.1f", val)
        callback(val)
    end

    bar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromX(input.Position.X)
        end
    end)
    UIS.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local rel0 = (defaultV - minV) / (maxV - minV)
    fill.Size = UDim2.new(rel0, 0, 1, 0)
    return fr
end

