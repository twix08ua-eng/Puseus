-- ==========================================================
local tabs = {
    exec    = {btn = tabExec,    frame = execFrame},
    move    = {btn = tabMove,    frame = moveFrame},
    scripts = {btn = tabScripts, frame = scriptsFrame},
}

function setTab(active)
    for name, t in pairs(tabs) do
        if name == active then
            t.frame.Visible        = true
            t.btn.BackgroundColor3 = Color3.fromRGB(100, 150, 255)
            t.btn.TextColor3       = Color3.new(1,1,1)
        else
            t.frame.Visible        = false
            t.btn.BackgroundColor3 = Color3.fromRGB(35, 35, 50)
            t.btn.TextColor3       = Color3.fromRGB(200, 200, 220)
        end
    end
end

tabExec.MouseButton1Click:Connect(function() setTab("exec")    end)
tabMove.MouseButton1Click:Connect(function() setTab("move")    end)
tabScripts.MouseButton1Click:Connect(function() setTab("scripts") end)

