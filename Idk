local function executeCode(code)
    if not code or code == "" then
        setStatus("⚠ Пустой скрипт", Color3.fromRGB(255, 200, 100))
        return
    end
    local fn, err = loadstring(code)
    if not fn then
        setStatus("❌ Ошибка компиляции: " .. tostring(err), Color3.fromRGB(255, 100, 100))
        return
    end
    local ok2, r = pcall(fn)
    if ok2 then
        setStatus("✅ Выполнено успешно", Color3.fromRGB(120, 255, 120))
    else
        setStatus("❌ Ошибка: " .. tostring(r), Color3.fromRGB(255, 100, 100))
    end
end

